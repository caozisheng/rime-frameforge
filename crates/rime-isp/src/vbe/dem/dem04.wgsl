struct DemosaicParams { cfa_pattern: vec4<u32>, thresholds: vec4<f32>, }
@group(0) @binding(0) var<uniform> params: DemosaicParams;
@group(0) @binding(1) var input_tex: texture_2d<f32>;
@group(0) @binding(2) var output_tex: texture_storage_2d<rgba32float, write>;
fn sample(p:vec2<i32>,e:vec2<u32>)->f32{return textureLoad(input_tex,clamp(p,vec2<i32>(0),vec2<i32>(e)-vec2<i32>(1)),0).r;}
fn cfa(p:vec2<i32>,e:vec2<u32>)->u32{let q=clamp(p,vec2<i32>(0),vec2<i32>(e)-vec2<i32>(1));let phase=vec2<u32>(u32(q.x)&1u,u32(q.y)&1u);return params.cfa_pattern[phase.y*2u+phase.x];}
fn green_dir(p:vec2<i32>,e:vec2<u32>,horizontal:bool)->f32{let position=clamp(p,vec2<i32>(0),vec2<i32>(e)-vec2<i32>(1));if(cfa(position,e)==1u){return sample(position,e);}let c=sample(position,e);let a=select(sample(position+vec2<i32>(0,-1),e),sample(position+vec2<i32>(-1,0),e),horizontal);let b=select(sample(position+vec2<i32>(0,1),e),sample(position+vec2<i32>(1,0),e),horizontal);let a2=select(sample(position+vec2<i32>(0,-2),e),sample(position+vec2<i32>(-2,0),e),horizontal);let b2=select(sample(position+vec2<i32>(0,2),e),sample(position+vec2<i32>(2,0),e),horizontal);return 0.5*(a+b)+0.25*(2.0*c-a2-b2);}
fn cardinal_difference(p:vec2<i32>,e:vec2<u32>,horizontal:bool,direction:bool)->f32{let position=clamp(p,vec2<i32>(0),vec2<i32>(e)-vec2<i32>(1));let a=select(position+vec2<i32>(0,-1),position+vec2<i32>(-1,0),horizontal);let b=select(position+vec2<i32>(0,1),position+vec2<i32>(1,0),horizontal);return 0.5*(sample(a,e)-green_dir(a,e,direction)+sample(b,e)-green_dir(b,e,direction));}
fn diagonal_difference(p:vec2<i32>,e:vec2<u32>,target_channel:u32,direction:bool)->f32{let position=clamp(p,vec2<i32>(0),vec2<i32>(e)-vec2<i32>(1));var sum=0.0;var count=0.0;for(var dy:i32=-1;dy<=1;dy+=2){for(var dx:i32=-1;dx<=1;dx+=2){let q=position+vec2<i32>(dx,dy);if(cfa(q,e)==target_channel){sum+=sample(q,e)-green_dir(q,e,direction);count+=1.0;}}}return sum/max(count,1.0);}
fn candidate(p:vec2<i32>,e:vec2<u32>,direction:bool)->vec3<f32>{let position=clamp(p,vec2<i32>(0),vec2<i32>(e)-vec2<i32>(1));let channel=cfa(position,e);let green=green_dir(position,e,direction);var rgb=vec3<f32>(green);if(channel==0u){rgb.r=sample(position,e);rgb.b=green+diagonal_difference(position,e,2u,direction);}else if(channel==2u){rgb.r=green+diagonal_difference(position,e,0u,direction);rgb.b=sample(position,e);}else{let row=cfa(vec2<i32>(position.x^1,position.y),e);if(row==0u){rgb.r=green+cardinal_difference(position,e,true,direction);rgb.b=green+cardinal_difference(position,e,false,direction);}else{rgb.b=green+cardinal_difference(position,e,true,direction);rgb.r=green+cardinal_difference(position,e,false,direction);}}return rgb;}
fn lab_f(t:f32)->f32{let delta=6.0/29.0;let delta3=delta*delta*delta;if(t>delta3){return pow(t,1.0/3.0);}return t/(3.0*delta*delta)+4.0/29.0;}
fn lab(rgb:vec3<f32>)->vec3<f32>{let x=(0.4124564*rgb.r+0.3575761*rgb.g+0.1804375*rgb.b)/0.95047;let y=0.2126729*rgb.r+0.7151522*rgb.g+0.0721750*rgb.b;let z=(0.0193339*rgb.r+0.1191920*rgb.g+0.9503041*rgb.b)/1.08883;let fx=lab_f(x);let fy=lab_f(y);let fz=lab_f(z);return vec3<f32>(116.0*fy-16.0,500.0*(fx-fy),200.0*(fy-fz));}
fn homogeneity(p:vec2<i32>,e:vec2<u32>,rgb:vec3<f32>,direction:bool)->f32{let center=lab(rgb);var count=0.0;for(var dy:i32=-1;dy<=1;dy++){for(var dx:i32=-1;dx<=1;dx++){if(dx==0&&dy==0){continue;}let neighbor=lab(candidate(p+vec2<i32>(dx,dy),e,direction));let dl=abs(center.x-neighbor.x);let da=center.y-neighbor.y;let db=center.z-neighbor.z;if(dl<params.thresholds.y&&da*da+db*db<params.thresholds.z){count+=1.0;}}}return count;}
@compute @workgroup_size(8,8)
fn demosaic_ahd_main(@builtin(global_invocation_id) gid:vec3<u32>){let extent=textureDimensions(input_tex);if(gid.x>=extent.x||gid.y>=extent.y){return;}let p=vec2<i32>(gid.xy);let horizontal=candidate(p,extent,true);let vertical=candidate(p,extent,false);let hh=homogeneity(p,extent,horizontal,true);let hv=homogeneity(p,extent,vertical,false);var rgb=0.5*(horizontal+vertical);if(hh>hv){rgb=horizontal;}else if(hv>hh){rgb=vertical;}textureStore(output_tex,p,vec4<f32>(rgb,1.0));}
